# 判定に使う API キー。どちらか片方を設定します。
# このファイルをコピーして .env.local を作り、キーを書き込んでください。
#   cp .env.example .env.local
# .env.local は .gitignore 済みです。NEXT_PUBLIC_ を付けないでください（ブラウザに漏れます）。

# 1) TypeSafe AI を直接呼ぶ場合
TYPESAFE_API_KEY=

# 2) Vercel AI Gateway 経由で呼ぶ場合（こちらを設定すると 1) より優先されます）
#    ログ・利用状況・予算上限が Vercel 側で見られるようになります。
# AI_GATEWAY_API_KEY=

# 任意: 既定は jev-latest
# TYPESAFE_DEFAULT_MODEL=jev-latest
